# PostgreSQL
POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://vpn:CHANGE_ME@postgres:5432/vpn

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram group/channel ID (e.g. -1001234567890)
# Bot must be an admin in this group
GROUP_ID=

# Your server's public IP address
SERVER_IP=

# Telegram admin user IDs (comma-separated), can use /myid bot to find out
ADMIN_IDS=

# AmneziaWG port (UDP)
AWG_PORT=51820

# Xray VLESS+Reality port
XRAY_PORT=443

# Xray Reality keys — filled by setup.sh
XRAY_REALITY_PRIVATE_KEY=
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=
XRAY_REALITY_SNI=www.microsoft.com

# MTProxy port and secret — filled by setup.sh
MTPROXY_PORT=8443
MTPROXY_SECRET=
