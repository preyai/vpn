# PostgreSQL
POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://vpn:CHANGE_ME@postgres:5432/vpn

# BOT_TOKEN, GROUP_ID and ADMIN_IDS are asked for / detected by setup.sh
# (re-run the Telegram part alone with: python3 scripts/telegram_setup.py)

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram group ID (e.g. -1001234567890)
# Bot must be an admin in this group
GROUP_ID=

# Your server's public IP address
SERVER_IP=

# Telegram admin user IDs (comma-separated)
ADMIN_IDS=

# AmneziaWG port (UDP)
AWG_PORT=51820

# Xray Reality keys — filled by setup.sh
XRAY_REALITY_PRIVATE_KEY=
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=
XRAY_REALITY_SNI=www.microsoft.com

# Telegram WEB proxy — asked for / generated by setup.sh.
# The domain needs an A record pointing at SERVER_IP; ports 80 and 443 must be open
TG_WEBPROXY_DOMAIN=
TG_WEBPROXY_SECRET=

# Domain for subscription links (/sub) — asked for by setup.sh, A record -> SERVER_IP
SUBS_DOMAIN=

# Optional: payment link shown as a button under the donation QR code (/donate)
DONATE_URL=
